<Window
    x:Class="RepartoCopier.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="RepartoCopier">

    <Grid x:Name="Root" Background="Transparent" SizeChanged="Root_SizeChanged">
        <Grid.Resources>
            <!-- Windows 11 spacing ramp: 4/8/12/16. Cards use the overlay radius, controls the control radius. -->
            <Style x:Key="SurfaceCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{ThemeResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="12" />
            </Style>
            <Style x:Key="SectionLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="MetricLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="MetricValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="MaxLines" Value="1" />
            </Style>
            <Style x:Key="IconButtonStyle" TargetType="Button">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <TitleBar x:Name="AppTitleBar" Grid.Row="0" Title="RepartoCopier">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="ms-appx:///Assets/AppLogo.png" />
            </TitleBar.IconSource>
            <TitleBar.RightHeader>
                <Button x:Name="AppMenuButton" Width="36" Height="30" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTipService.ToolTip="Más opciones" AutomationProperties.Name="Más opciones">
                    <FontIcon Glyph="&#xE712;" FontSize="16" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem Text="Cargar copia…" Click="LoadProfile_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="O" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Guardar copia…" Click="SaveProfile_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74E;" /></MenuFlyoutItem.Icon>
                                <MenuFlyoutItem.KeyboardAccelerators>
                                    <KeyboardAccelerator Modifiers="Control" Key="S" />
                                </MenuFlyoutItem.KeyboardAccelerators>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Ajustes" Click="Settings_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Acerca de" Click="About_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE946;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="Salir" Click="Exit_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </TitleBar.RightHeader>
        </TitleBar>

        <InfoBar x:Name="ErrorBar" Grid.Row="1" Margin="12,0,12,4" IsOpen="False" Severity="Error"
                 Title="No se pudo completar" IsClosable="True" />

        <ScrollViewer x:Name="MainContentScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Auto" VerticalScrollMode="Enabled">
            <!-- MaxWidth keeps line lengths readable on wide/maximized windows; content stays centered. -->
            <Grid x:Name="ContentHost" Padding="16,8,16,16" MaxWidth="980" HorizontalAlignment="Stretch">

                <StackPanel x:Name="PreparationPanel" Visibility="Visible" Spacing="12">

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Nueva copia" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Name="SubtitleText" Text="Un origen, varios destinos a la vez"
                                       Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="StartButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}"
                                MinHeight="36" MinWidth="128" Click="Start_Click" VerticalAlignment="Center"
                                AutomationProperties.Name="Iniciar copia">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Modifiers="Control" Key="Enter" />
                            </Button.KeyboardAccelerators>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE768;" FontSize="14"/>
                                <TextBlock Text="Iniciar copia"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Source -->
                    <Border Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8B7;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                <TextBlock Text="Origen" Style="{StaticResource SectionLabelStyle}"/>
                            </StackPanel>
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="SourcePathBox" PlaceholderText="Elige un archivo o una carpeta" IsReadOnly="True"
                                         AutomationProperties.Name="Origen" VerticalAlignment="Center" />
                                <Button x:Name="PickSourceFileButton" Grid.Column="1" MinHeight="32" Click="PickSourceFile_Click"
                                        ToolTipService.ToolTip="Elegir archivo" AutomationProperties.Name="Elegir archivo">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8A5;" FontSize="14"/>
                                        <TextBlock x:Name="PickSourceFileLabel" Text="Archivo"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="PickSourceFolderButton" Grid.Column="2" MinHeight="32" Click="PickSourceFolder_Click"
                                        ToolTipService.ToolTip="Elegir carpeta" AutomationProperties.Name="Elegir carpeta">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8B7;" FontSize="14"/>
                                        <TextBlock x:Name="PickSourceFolderLabel" Text="Carpeta"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Destinations -->
                    <Border Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel Spacing="8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="Destinos" Style="{StaticResource SectionLabelStyle}"/>
                                    <TextBlock x:Name="DestinationCountText" Text="0 destinos" VerticalAlignment="Center"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button x:Name="AddDestinationsButton" MinHeight="32" Click="AddDestinations_Click"
                                            AutomationProperties.Name="Agregar destinos">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                            <TextBlock Text="Agregar"/>
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="ClearDestinationsButton" Style="{StaticResource IconButtonStyle}" Click="ClearDestinations_Click"
                                            ToolTipService.ToolTip="Quitar todos" AutomationProperties.Name="Quitar todos los destinos">
                                        <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <TextBlock x:Name="DestinationsEmptyText" Text="Agrega una o más carpetas de destino."
                                       Style="{StaticResource CaptionTextBlockStyle}" TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}" />

                            <!-- Responsive chips: as many columns as fit, then wrap; scroll only past ~3 rows. -->
                            <ScrollViewer x:Name="DestinationListHost" MaxHeight="124" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled">
                                <ItemsRepeater x:Name="DestinationList">
                                    <ItemsRepeater.Layout>
                                        <UniformGridLayout MinItemWidth="168" MinItemHeight="36" MinRowSpacing="4" MinColumnSpacing="4"
                                                           ItemsStretch="Fill" />
                                    </ItemsRepeater.Layout>
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate>
                                            <Border Height="36" Padding="10,0,2,0" CornerRadius="{ThemeResource ControlCornerRadius}"
                                                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                                                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                                    ToolTipService.ToolTip="{Binding Path}">
                                                <Grid ColumnSpacing="8">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <FontIcon Glyph="&#xEDA2;" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <Button Grid.Column="2" Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                                                            Tag="{Binding Path}" Click="RemoveDestination_Click"
                                                            ToolTipService.ToolTip="Quitar" AutomationProperties.Name="Quitar destino">
                                                        <FontIcon Glyph="&#xE711;" FontSize="12"/>
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>

                    <!-- Options -->
                    <Expander x:Name="OptionsExpander" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE713;" FontSize="16"/>
                                <TextBlock Text="Opciones" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Expander.Header>
                        <StackPanel Spacing="8">
                            <ComboBox x:Name="ExistingFilesCombo" Header="Si ya existen archivos en el destino" HorizontalAlignment="Stretch"
                                      SelectedIndex="0" AutomationProperties.Name="Si ya existen archivos en el destino">
                                <ComboBoxItem Content="Omitir iguales por tamaño y fecha (rápido)"
                                              ToolTipService.ToolTip="No lee contenido. Reemplaza los que difieran en tamaño o fecha."/>
                                <ComboBoxItem Content="Preguntar cada vez"/>
                                <ComboBoxItem Content="Conservar existentes"/>
                                <ComboBoxItem Content="Comparar contenido y reemplazar distintos"/>
                                <ComboBoxItem Content="Reemplazar todos"/>
                            </ComboBox>
                            <CheckBox x:Name="IndependentReadsCheck" IsChecked="True"
                                      ToolTipService.ToolTip="Cada destino lee el origen a su ritmo con su propio búfer: un USB lento no frena a un NVMe. Se usa automáticamente con origen SSD NVMe/SATA local, de 2 a 16 destinos y sin destinos en el mismo disco; si no, se usa la lectura compartida.">
                                <TextBlock Text="Lectura independiente por destino (recomendado)" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="VerifyCheck" IsChecked="False"
                                      ToolTipService.ToolTip="Relee todo el origen y los destinos. Sin esta opción, la copia termina tras escribir y confirmar los archivos, sin comprobar su contenido mediante relectura.">
                                <TextBlock Text="Verificar contenido al terminar" TextWrapping="Wrap"/>
                            </CheckBox>
                            <CheckBox x:Name="KeepGoingCheck">
                                <TextBlock Text="Continuar si falla un archivo" TextWrapping="Wrap"/>
                            </CheckBox>
                        </StackPanel>
                    </Expander>
                </StackPanel>

                <StackPanel x:Name="RunningPanel" Visibility="Collapsed" Spacing="12" VerticalAlignment="Top">
                    <Border Style="{StaticResource SurfaceCardStyle}">
                        <StackPanel Spacing="12">

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border Width="40" Height="40" CornerRadius="{ThemeResource OverlayCornerRadius}"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}" VerticalAlignment="Center">
                                    <FontIcon x:Name="OperationIcon" Glyph="&#xE8A5;" FontSize="20"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="OperationTitleText" Text="Copiando…" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock x:Name="CurrentFileText" Text="Preparando…" Style="{StaticResource BodyStrongTextBlockStyle}"
                                               FontSize="16" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                    <TextBlock x:Name="CurrentPathText" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxLines="1"/>
                                </StackPanel>
                                <TextBlock x:Name="OverallPercentText" Grid.Column="2" Text="0%" Style="{StaticResource SubtitleTextBlockStyle}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <StackPanel Spacing="4">
                                <ProgressBar x:Name="OverallProgressBar" Height="10" MinHeight="10" Minimum="0" Maximum="100" Value="0">
                                    <ProgressBar.Resources>
                                        <x:Double x:Key="ProgressBarTrackHeight">10</x:Double>
                                    </ProgressBar.Resources>
                                </ProgressBar>
                                <TextBlock x:Name="OverallDetailText" Text="Preparando…" TextWrapping="Wrap"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Grid ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xEC4A;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Velocidad" Style="{StaticResource MetricLabelStyle}"/>
                                        <TextBlock x:Name="SpeedMetricText" Text="0 MiB/s" Style="{StaticResource MetricValueStyle}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Column="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE916;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Restante" Style="{StaticResource MetricLabelStyle}"/>
                                        <TextBlock x:Name="RemainingMetricText" Text="--:--:--" Style="{StaticResource MetricValueStyle}"/>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Column="2" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <FontIcon Glyph="&#xE8A5;" FontSize="16" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Archivos" Style="{StaticResource MetricLabelStyle}"/>
                                        <TextBlock x:Name="FilesMetricText" Text="0/0" Style="{StaticResource MetricValueStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>

                            <Grid ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Button x:Name="PauseButton" MinHeight="32" MinWidth="104" IsEnabled="False" Click="Pause_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" FontSize="14"/>
                                        <TextBlock x:Name="PauseButtonText" Text="Pausar"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="CancelButton" Grid.Column="1" MinHeight="32" MinWidth="104" IsEnabled="False" Click="Cancel_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE711;" FontSize="14"/>
                                        <TextBlock Text="Cancelar"/>
                                    </StackPanel>
                                </Button>
                                <CheckBox x:Name="ShutdownCheck" Grid.Column="2" HorizontalAlignment="Right" MinWidth="0"
                                          AutomationProperties.Name="Apagar al terminar">
                                    <TextBlock Text="Apagar al terminar" TextWrapping="NoWrap"/>
                                </CheckBox>
                            </Grid>

                            <StackPanel x:Name="ResultActions" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button x:Name="ResultDetailsButton" MinHeight="32" Visibility="Collapsed" Click="ResultDetails_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE9D9;" FontSize="14"/>
                                        <TextBlock Text="Detalles"/>
                                    </StackPanel>
                                </Button>
                                <Button x:Name="NewCopyButton" MinHeight="32" Visibility="Collapsed" Click="NewCopy_Click"
                                        Style="{StaticResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="14"/>
                                        <TextBlock Text="Nueva copia"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- One card per destination; columns adapt to the window width. -->
                    <StackPanel x:Name="RunningDestinationScroll" Visibility="Collapsed" Spacing="8">
                        <TextBlock Text="Por destino" Style="{StaticResource SectionLabelStyle}"/>
                        <ItemsRepeater x:Name="RunningDestinationList">
                            <ItemsRepeater.Layout>
                                <UniformGridLayout MinItemWidth="200" MinItemHeight="64" MinRowSpacing="8" MinColumnSpacing="8"
                                                   ItemsStretch="Fill" />
                            </ItemsRepeater.Layout>
                            <ItemsRepeater.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,8" CornerRadius="{ThemeResource OverlayCornerRadius}"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                            ToolTipService.ToolTip="{Binding Detail}" AutomationProperties.Name="{Binding Detail}">
                                        <StackPanel Spacing="6">
                                            <Grid ColumnSpacing="8">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <FontIcon Glyph="{Binding Glyph}" FontSize="14" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Progress}" Style="{StaticResource CaptionTextBlockStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent}" ShowError="{Binding IsFailed}"
                                                         ShowPaused="{Binding IsPaused}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsRepeater.ItemTemplate>
                        </ItemsRepeater>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="3" Padding="12,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Listo" Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="ElapsedText" Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
