<Window
    x:Class="RepartoCopier.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="RepartoCopier">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.Resources>
            <Style x:Key="SurfaceCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="12" />
            </Style>
            <Style x:Key="CompactActionButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="42" />
                <Setter Property="MinWidth" Value="100" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style x:Key="MenuButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="46" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="CornerRadius" Value="7" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="22,0,148,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image x:Name="LogoImage"
                   Width="36"
                   Height="36"
                   Margin="3"
                   Source="ms-appx:///Assets/AppLogo.png"
                   Stretch="Uniform"
                   UseLayoutRounding="True"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center" />

            <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" Spacing="2">
                <TextBlock Text="RepartoCopier" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Copia FAN-OUT para Windows" Opacity="0.62" FontSize="11" />
            </StackPanel>

            <Button x:Name="AppMenuButton"
                    Grid.Column="3"
                    Width="40"
                    Height="36"
                    Padding="0"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    CornerRadius="10"
                    ToolTipService.ToolTip="Menú">
                <FontIcon Glyph="&#xE700;" FontSize="20" />
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <Border Width="224" Padding="7" CornerRadius="10"
                                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <StackPanel Spacing="2">
                                <Button Style="{StaticResource MenuButtonStyle}" Click="LoadProfile_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8E5;" FontSize="18"/><TextBlock Text="Cargar copia..." FontSize="14"/></StackPanel>
                                </Button>
                                <Button Style="{StaticResource MenuButtonStyle}" Click="SaveProfile_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE74E;" FontSize="18"/><TextBlock Text="Guardar copia..." FontSize="14"/></StackPanel>
                                </Button>
                                <Rectangle Height="1" Margin="8,5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Button Style="{StaticResource MenuButtonStyle}" Click="Settings_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE713;" FontSize="18"/><TextBlock Text="Ajustes" FontSize="14"/></StackPanel>
                                </Button>
                                <Button x:Name="AboutMenuButton" Style="{StaticResource MenuButtonStyle}" Click="About_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE946;" FontSize="18"/><TextBlock Text="Acerca de" FontSize="14"/></StackPanel>
                                </Button>
                                <Rectangle Height="1" Margin="8,5" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                <Button Style="{StaticResource MenuButtonStyle}" Click="Exit_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE8BB;" FontSize="18"/><TextBlock Text="Salir" FontSize="14"/></StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="22,6,22,12" MaxWidth="980" HorizontalAlignment="Stretch">
            <InfoBar x:Name="ErrorBar"
                     VerticalAlignment="Top"
                     Margin="0,0,0,10"
                     IsOpen="False"
                     Severity="Error"
                     IsClosable="True"
                     Canvas.ZIndex="10" />

            <Grid x:Name="PreparationPanel" Visibility="Visible" RowSpacing="11" MaxWidth="800" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="4" Margin="0,0,0,2">
                    <TextBlock Text="Nueva copia" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Elige qué quieres copiar y dónde quieres guardarlo." Opacity="0.68" FontSize="14" />
                </StackPanel>

                <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Padding="14,12">
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Qué quieres copiar" FontSize="14" FontWeight="SemiBold" />
                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SourcePathBox" Height="42" PlaceholderText="Selecciona un archivo o una carpeta" IsReadOnly="True" CornerRadius="7" />
                            <Button Grid.Column="1" Style="{StaticResource CompactActionButtonStyle}" Click="PickSourceFile_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                    <TextBlock Text="Archivo" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource CompactActionButtonStyle}" Click="PickSourceFolder_Click">
                                <StackPanel Orientation="Horizontal" Spacing="7">
                                    <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                                    <TextBlock Text="Carpeta" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource SurfaceCardStyle}" Padding="14,12">
                    <Grid RowSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Spacing="1">
                                <TextBlock Text="Dónde copiar" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="DestinationCountText" Text="0 destinos" Opacity="0.62" FontSize="11" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                                <Button Height="36" Padding="12,0" CornerRadius="7" Click="AddDestinations_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="7">
                                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                                        <TextBlock Text="Agregar" />
                                    </StackPanel>
                                </Button>
                                <Button Width="38" Height="36" Padding="0" CornerRadius="7" Click="ClearDestinations_Click" ToolTipService.ToolTip="Quitar todos los destinos">
                                    <FontIcon Glyph="&#xE74D;" FontSize="13" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ListView x:Name="DestinationList" Grid.Row="1" SelectionMode="None" MaxHeight="132" Padding="0" IsTabStop="False">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,1" />
                                    <Setter Property="MinHeight" Value="42" />
                                    <Setter Property="CornerRadius" Value="7" />
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid MinHeight="36" Padding="9,2" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Glyph="&#xEDA2;" FontSize="16" Opacity="0.80" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Path}" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Width="30" Height="28" Padding="0" CornerRadius="6" Tag="{Binding Path}" Click="RemoveDestination_Click" ToolTipService.ToolTip="Quitar destino">
                                            <FontIcon Glyph="&#xE711;" FontSize="11" />
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" Margin="2,0,2,0" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                        <CheckBox x:Name="VerifyCheck" Content="Verificar después de copiar" IsChecked="True" />
                        <CheckBox x:Name="SkipSameCheck" Content="Omitir archivos iguales" />
                        <CheckBox x:Name="KeepGoingCheck" Content="Continuar si un destino falla" />
                    </StackPanel>
                    <Button x:Name="StartButton" Grid.Column="1" Style="{StaticResource AccentButtonStyle}" Height="40" MinWidth="138" CornerRadius="8" Click="Start_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Iniciar copia" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <Grid x:Name="RunningPanel" Visibility="Collapsed" RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Style="{StaticResource SurfaceCardStyle}" Padding="14,12">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="48" Height="48" CornerRadius="10" Background="{ThemeResource ControlFillColorDefaultBrush}" VerticalAlignment="Center">
                            <FontIcon x:Name="OperationIcon" Glyph="&#xE8A5;" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center" MinWidth="250">
                            <TextBlock x:Name="OperationTitleText" Text="Copiando..." FontSize="14" Opacity="0.88" />
                            <TextBlock x:Name="CurrentFileText" Text="Preparando..." FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                            <TextBlock x:Name="CurrentPathText" Opacity="0.62" FontSize="12" TextTrimming="CharacterEllipsis" MaxLines="1" />
                        </StackPanel>

                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="1"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="1"/><ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid Margin="18,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE9D9;" FontSize="23" Opacity="0.76" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="2" MinWidth="112"><TextBlock Text="Velocidad" Opacity="0.60" FontSize="11"/><TextBlock x:Name="SpeedMetricText" Text="0 MiB/s" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                            </Grid>
                            <Rectangle Grid.Column="1" Width="1" Margin="4,2" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid Grid.Column="2" Margin="18,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE916;" FontSize="23" Opacity="0.76" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="2" MinWidth="120"><TextBlock Text="Tiempo restante" Opacity="0.60" FontSize="11"/><TextBlock x:Name="RemainingMetricText" Text="--:--:--" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                            </Grid>
                            <Rectangle Grid.Column="3" Width="1" Margin="4,2" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid Grid.Column="4" Margin="18,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xE8A5;" FontSize="22" Opacity="0.76" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Spacing="2" MinWidth="86"><TextBlock Text="Archivos" Opacity="0.60" FontSize="11"/><TextBlock x:Name="FilesMetricText" Text="0/0" FontSize="20" FontWeight="SemiBold"/></StackPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource SurfaceCardStyle}" Padding="14,10">
                    <Grid RowSpacing="7">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Progreso total" FontSize="13" FontWeight="SemiBold" />
                            <TextBlock x:Name="OverallPercentText" HorizontalAlignment="Right" Text="0%" FontSize="13" FontWeight="SemiBold" />
                        </Grid>
                        <ProgressBar x:Name="OverallProgressBar" Grid.Row="1" Height="6" Minimum="0" Maximum="100" Value="0" />
                        <TextBlock x:Name="OverallDetailText" Grid.Row="2" Text="Preparando..." Opacity="0.60" FontSize="11" />
                    </Grid>
                </Border>

                <Grid Grid.Row="2" Margin="2,2" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PauseButton" Height="36" MinWidth="116" IsEnabled="False" CornerRadius="7" Click="Pause_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon x:Name="PauseIcon" Glyph="&#xE769;" />
                            <TextBlock x:Name="PauseButtonText" Text="Pausar" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton" Grid.Column="1" Height="36" MinWidth="116" IsEnabled="False" CornerRadius="7" Click="Cancel_Click">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;" />
                            <TextBlock Text="Cancelar" />
                        </StackPanel>
                    </Button>
                    <CheckBox x:Name="ShutdownCheck" Grid.Column="3" Content="Apagar el equipo al finalizar" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="24,0" BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <TextBlock x:Name="StatusText" Text="Listo" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="ElapsedText" HorizontalAlignment="Right" FontSize="11" Opacity="0.70" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>