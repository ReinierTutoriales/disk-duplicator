<Window
    x:Class="RepartoCopier.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="RepartoCopier">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="SourceActions.Orientation" Value="Vertical" />
                        <Setter Target="CommandPanel.Orientation" Value="Vertical" />
                        <Setter Target="CommandPanel.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="DestinationList.MaxHeight" Value="108" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SourceActions.Orientation" Value="Horizontal" />
                        <Setter Target="CommandPanel.Orientation" Value="Horizontal" />
                        <Setter Target="CommandPanel.HorizontalAlignment" Value="Right" />
                        <Setter Target="DestinationList.MaxHeight" Value="128" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,12,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Image x:Name="LogoImage"
                   Width="32"
                   Height="32"
                   Stretch="Uniform"
                   VerticalAlignment="Center" />

            <StackPanel Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Spacing="0">
                <TextBlock Text="RepartoCopier" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Text="FAN-OUT nativo para Windows" Opacity="0.62" FontSize="10.5" />
            </StackPanel>

            <ComboBox x:Name="ThemeSelector"
                      Grid.Column="3"
                      Width="112"
                      Height="32"
                      VerticalAlignment="Center"
                      SelectionChanged="ThemeSelector_SelectionChanged">
                <ComboBoxItem Content="Sistema" Tag="Default" IsSelected="True" />
                <ComboBoxItem Content="Claro" Tag="Light" />
                <ComboBoxItem Content="Oscuro" Tag="Dark" />
            </ComboBox>
        </Grid>

        <Grid Grid.Row="1"
              Margin="16,12,16,12"
              MaxWidth="1080"
              HorizontalAlignment="Center"
              RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <InfoBar x:Name="ErrorBar"
                     Grid.Row="0"
                     Margin="0,0,0,10"
                     IsOpen="False"
                     Severity="Error"
                     IsClosable="True" />

            <Border Grid.Row="0"
                    Padding="12"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock Text="Origen" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="La carpeta raíz se conserva en cada destino."
                                       Opacity="0.62"
                                       FontSize="11" />
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SourcePathBox"
                                 Height="34"
                                 PlaceholderText="Archivo o carpeta de origen"
                                 IsReadOnly="True" />
                        <StackPanel x:Name="SourceActions"
                                    Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="6"
                                    Margin="8,0,0,0">
                            <Button Content="Archivo" Height="34" MinWidth="84" Click="PickSourceFile_Click" />
                            <Button Content="Carpeta" Height="34" MinWidth="84" Click="PickSourceFolder_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Padding="12"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="1">
                            <TextBlock Text="Destinos" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock x:Name="DestinationCountText" Text="0 destinos" Opacity="0.62" FontSize="11" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <Button Content="Agregar" Height="32" Click="AddDestinations_Click" />
                            <Button Content="Limpiar" Height="32" Click="ClearDestinations_Click" />
                        </StackPanel>
                    </Grid>

                    <ListView x:Name="DestinationList"
                              Grid.Row="1"
                              SelectionMode="None"
                              MaxHeight="128"
                              Padding="0"
                              IsTabStop="False">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,1" />
                                <Setter Property="MinHeight" Value="32" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="32" Padding="8,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Path}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1"
                                            Width="30"
                                            Height="28"
                                            Padding="0"
                                            Tag="{Binding Path}"
                                            Click="RemoveDestination_Click"
                                            ToolTipService.ToolTip="Quitar destino">
                                        <FontIcon Glyph="&#xE711;" FontSize="11" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Row="2"
                    Padding="12,10"
                    CornerRadius="8"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                        <CheckBox x:Name="SkipSameCheck" Content="Omitir archivos iguales" IsChecked="False" />
                        <CheckBox x:Name="KeepGoingCheck" Content="Continuar si un destino falla" />
                    </StackPanel>
                    <StackPanel x:Name="CommandPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                Spacing="6"
                                HorizontalAlignment="Right">
                        <Button x:Name="StartButton"
                                Content="Iniciar copia"
                                Style="{StaticResource AccentButtonStyle}"
                                Height="34"
                                MinWidth="116"
                                Click="Start_Click" />
                        <Button x:Name="PauseButton"
                                Content="Pausar"
                                Height="34"
                                MinWidth="82"
                                IsEnabled="False"
                                Click="Pause_Click" />
                        <Button x:Name="CancelButton"
                                Content="Cancelar"
                                Height="34"
                                MinWidth="82"
                                IsEnabled="False"
                                Click="Cancel_Click" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="3" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Progreso por destino" FontSize="14" FontWeight="SemiBold" />
                <ListView x:Name="ProgressList"
                          Grid.Row="1"
                          SelectionMode="None"
                          Padding="0"
                          IsTabStop="False">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10"
                                    CornerRadius="8"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <Grid RowSpacing="5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding PhaseText}"
                                                   FontSize="11"
                                                   Opacity="0.70"
                                                   Margin="10,0,0,0" />
                                    </Grid>
                                    <ProgressBar Grid.Row="1"
                                                 Height="3"
                                                 Minimum="0"
                                                 Maximum="100"
                                                 Value="{Binding Percent}" />
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Detail}"
                                                   FontSize="11"
                                                   Opacity="0.66"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Speed}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Margin="10,0,0,0" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <Border Grid.Row="2"
                Padding="16,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText"
                           Text="Listo"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
                <TextBlock x:Name="OverallSpeedText"
                           Grid.Column="1"
                           Margin="12,0,0,0"
                           FontSize="11"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
