<Window
    x:Class="RepartoCopier.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="RepartoCopier">

    <Grid x:Name="Root" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualState x:Name="Narrow">
                    <VisualState.Setters>
                        <Setter Target="SourceActions.Orientation" Value="Vertical" />
                        <Setter Target="CommandPanel.Orientation" Value="Vertical" />
                        <Setter Target="CommandPanel.HorizontalAlignment" Value="Stretch" />
                        <Setter Target="DestinationList.MaxHeight" Value="210" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="SourceActions.Orientation" Value="Horizontal" />
                        <Setter Target="CommandPanel.Orientation" Value="Horizontal" />
                        <Setter Target="CommandPanel.HorizontalAlignment" Value="Right" />
                        <Setter Target="DestinationList.MaxHeight" Value="280" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,12,0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="RepartoCopier" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="FAN-OUT nativo para Windows" Opacity="0.65" FontSize="11" />
            </StackPanel>
            <ComboBox x:Name="ThemeSelector" Grid.Column="2" Width="116" VerticalAlignment="Center" SelectionChanged="ThemeSelector_SelectionChanged">
                <ComboBoxItem Content="Sistema" Tag="Default" IsSelected="True" />
                <ComboBoxItem Content="Claro" Tag="Light" />
                <ComboBoxItem Content="Oscuro" Tag="Dark" />
            </ComboBox>
        </Grid>

        <ScrollViewer Grid.Row="1" HorizontalScrollMode="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="20,12,20,20" Spacing="12" MaxWidth="1180" HorizontalAlignment="Stretch">
                <InfoBar x:Name="ErrorBar" IsOpen="False" Severity="Error" IsClosable="True" />

                <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Origen" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Selecciona un archivo o una carpeta completa. La carpeta raíz se conserva en cada destino." Opacity="0.72" TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SourcePathBox" PlaceholderText="Archivo o carpeta de origen" IsReadOnly="True" />
                            <StackPanel x:Name="SourceActions" Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="8,0,0,0">
                                <Button Content="Archivo" MinWidth="92" Click="PickSourceFile_Click" />
                                <Button Content="Carpeta" MinWidth="92" Click="PickSourceFolder_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Spacing="10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Destinos" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="DestinationCountText" Text="0 destinos" Opacity="0.68" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="Agregar" Click="AddDestinations_Click" />
                                <Button Content="Limpiar" Click="ClearDestinations_Click" />
                            </StackPanel>
                        </Grid>
                        <ListView x:Name="DestinationList" SelectionMode="None" MaxHeight="280">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Quitar" Tag="{Binding Path}" Click="RemoveDestination_Click" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <Border Padding="16" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <CheckBox x:Name="SkipSameCheck" Content="Omitir archivos iguales" IsChecked="True" />
                            <CheckBox x:Name="KeepGoingCheck" Content="Continuar si un destino falla" />
                        </StackPanel>
                        <StackPanel x:Name="CommandPanel" Grid.Row="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                            <Button x:Name="StartButton" Content="Iniciar copia" Style="{StaticResource AccentButtonStyle}" MinWidth="124" Click="Start_Click" />
                            <Button x:Name="PauseButton" Content="Pausar" MinWidth="96" IsEnabled="False" Click="Pause_Click" />
                            <Button x:Name="CancelButton" Content="Cancelar" MinWidth="96" IsEnabled="False" Click="Cancel_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Spacing="8">
                    <TextBlock Text="Progreso por destino" FontSize="16" FontWeight="SemiBold" />
                    <ListView x:Name="ProgressList" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Padding="14" CornerRadius="8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                                    <Grid RowSpacing="8">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding PhaseText}" Opacity="0.75" Margin="12,0,0,0" />
                                        </Grid>
                                        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding Percent}" />
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Detail}" Opacity="0.70" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Speed}" FontWeight="SemiBold" Margin="12,0,0,0" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Padding="16,10" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="Listo" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                <TextBlock x:Name="OverallSpeedText" Grid.Column="1" Margin="12,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
